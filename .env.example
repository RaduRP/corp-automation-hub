# 1. Создаем файл-пример для коллег (без реальных паролей!)
cat << 'EOF' > .env.example
# PostgreSQL Configuration
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=n8n_database

# Timezone
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Encryption Key (generate 32 random characters)
N8N_ENCRYPTION_KEY=change_me_to_random_string
EOF

# 2. Убеждаемся, что .env внесен в .gitignore
grep -qxF ".env" .gitignore || echo ".env" >> .gitignore

# 3. Инициализируем Git в нашей папке
git init -b main

# 4. Проверяем статус
git status